<!DOCTYPE html>
<html>
<head>
<title>Giant Button</title>
<style>
 body {
 display: flex;
 justify-content: center;
 align-items: center;
 height: 100vh;
 margin: 0;
 background-color: #f0f0f0;
 }

 .giant-button {
 padding: 50px 100px;
 font-size: 80px;
 font-weight: bold;
 color: white;
 background-color: #ff4757;
 border: none;
 border-radius: 25px;
 cursor: pointer;
 box-shadow: 0 15px #c0392b;
 outline: none;
 transition: all 0.2s;
 }

 .giant-button:hover {
 background-color: #e84118;
 }

 .giant-button:active {
 background-color: #c23616;
 box-shadow: 0 5px #c0392b;
 transform: translateY(10px);
 }
</style>
</head>
<body>

<button class="giant-button">dupe</button>

</body>
</html>
